# Google Gemini - usado para gerar roteiros automaticamente (opcional, GRÁTIS)
# Pegue sua chave em https://aistudio.google.com/app/apikey
# Cota grátis generosa: ~1500 requisições/dia no gemini-2.0-flash
GEMINI_API_KEY=

# Pexels - usado para buscar imagens/vídeos de fundo (opcional, mas recomendado)
# Crie uma chave grátis em https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay - alternativa gratuita ao Pexels (opcional)
# Pegue uma chave grátis em https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Voz padrão do edge-tts (Português Brasil)
# Outras opções: pt-BR-AntonioNeural (masc), pt-BR-FranciscaNeural (fem),
# pt-BR-ThalitaMultilingualNeural (fem multilíngue mais natural)
VIDEOGEN_VOICE=pt-BR-FranciscaNeural

# Resolução padrão (vertical 9:16 para TikTok/Reels/Shorts)
VIDEOGEN_WIDTH=1080
VIDEOGEN_HEIGHT=1920
VIDEOGEN_FPS=30
